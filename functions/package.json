{
  "name": "functions",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "purge:author-email:dry": "node scripts/purge-author-email.mjs --project-id=el-alma-de-las-flores-blog --dry-run",
    "purge:author-email": "node scripts/purge-author-email.mjs --project-id=el-alma-de-las-flores-blog --execute"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.0.0"
  },
  "overrides": {
    "@firebase/database-compat": "2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.3.1",
    "globals": "^17.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  },
  "private": true
}

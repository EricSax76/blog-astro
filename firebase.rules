rules_version = '2';

// Todas las escrituras pasan por Cloud Functions (Admin SDK, que ignora estas
// reglas). El SDK cliente solo lee: así ninguna escritura puede saltarse la
// validación/sanitización del backend (publishPost, addComment, toggleLike,
// deleteComment, upsertUserProfile, deleteUserData).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Lectura pública del blog. Escritura solo desde Cloud Functions.
    match /posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    // Perfil privado: lectura solo del propio usuario.
    // Escritura solo desde Cloud Functions (upsertUserProfile).
    match /users/{userId} {
      allow read: if isOwnUser(userId);
      allow write: if false;
    }

    // Social Interactions: Likes (escritura via toggleLike)
    match /likes/{likeId} {
      allow read: if true;
      allow write: if false;
    }

    // Social Interactions: Comments (escritura via addComment/deleteComment)
    match /comments/{commentId} {
      allow read: if true;
      allow write: if false;
    }

    // Deniega por defecto cualquier otra colección.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

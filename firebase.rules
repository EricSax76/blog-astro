rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidDisplayName() {
      return !request.resource.data.keys().hasAny(["displayName"])
        || (request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 50);
    }

    function isValidPhotoURL() {
      return !request.resource.data.keys().hasAny(["photoURL"])
        || (request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 2048);
    }

    function isAllowedUserProfilePatch() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "displayName",
          "photoURL",
          "updatedAt",
          "lastSeenAt"
        ])
        && isValidDisplayName()
        && isValidPhotoURL();
    }

    function isPostOwner() {
      return isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // Lectura pública del blog. Creación y edición solo vía publishPost
    // (Admin SDK): el cliente no tiene función ni UI de edición, así que
    // cerrar create/update no quita funcionalidad y evita que se salten los
    // límites de tamaño, el saneado y la derivación server-side de
    // imageUrl/authorName. Delete se mantiene: es autoservicio del propio
    // dueño y no involucra contenido sin sanear.
    match /posts/{postId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if isPostOwner();
    }

    // Perfil privado por usuario:
    // - lectura: solo el propio usuario
    // - actualización: solo campos de perfil editables por cliente
    // - creación/borrado: solo backend (Cloud Functions admin)
    match /users/{userId} {
      allow read: if isOwnUser(userId);
      allow update: if isOwnUser(userId) && isAllowedUserProfilePatch();
      allow create, delete: if false;
    }

    // Social Interactions: Likes. Toggle solo vía toggleLike (Admin SDK):
    // mantiene el contador likeCount del post en la misma transacción, algo
    // que una escritura directa del cliente no puede garantizar.
    match /likes/{likeId} {
      allow read: if true;
      allow create: if false;
      allow delete: if false;
    }

    // Social Interactions: Comments. Creación solo vía addComment (Admin SDK):
    // aplica límite de longitud, saneado y rate limiting que el cliente no
    // puede saltarse. Delete se mantiene: autoservicio del propio autor.
    match /comments/{commentId} {
      allow read: if true;
      allow create: if false;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Deniega por defecto cualquier otra colección.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

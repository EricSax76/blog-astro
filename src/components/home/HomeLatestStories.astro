---
interface Props {
  newestArchiveYear: number;
}

const { newestArchiveYear } = Astro.props;
---

<section id="cuaderno-vivo" class="mx-auto mt-24 max-w-6xl scroll-mt-24 px-6 md:px-12" data-reveal>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-2">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-moss-text">
        Cuaderno vivo
      </p>
      <h2 class="font-serif text-3xl font-bold text-ink md:text-4xl">
        Lo último que se ha escrito en el jardín
      </h2>
    </div>
    <a
      href={`/archivo/${newestArchiveYear}`}
      class="rounded-full border border-moss/30 px-5 py-2 text-sm font-semibold text-ink transition-colors hover:bg-moss/10"
    >
      Ir al anuario {newestArchiveYear}
    </a>
  </div>

  <div
    id="latest-stories"
    class="mt-10 grid gap-6 lg:grid-cols-2"
    aria-live="polite"
  >
    <p
      id="latest-stories-loading"
      class="col-span-full text-sm text-ink/60"
    >
      Cargando publicaciones recientes…
    </p>
    <div
      id="latest-stories-empty"
      class="hidden col-span-full rounded-3xl border border-moss/15 bg-paper-dim/60 p-8 text-center"
    >
      <p class="font-serif text-xl font-bold text-ink">Del herbario</p>
      <p class="mt-2 text-sm leading-relaxed text-ink/70">
        Todavía no hay publicaciones nuevas. Mientras tanto, recorre el
        <a
          href={`/archivo/${newestArchiveYear}`}
          class="font-semibold text-moss-text hover:text-ink"
        >
          anuario {newestArchiveYear}
        </a>
        para descubrir entradas del archivo.
      </p>
    </div>
  </div>
</section>

<script src="../../scripts/home/latest-stories.ts"></script>

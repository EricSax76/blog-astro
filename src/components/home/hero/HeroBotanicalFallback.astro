---
// Variante 2.5D: capas de imagen con profundidad simulada por escala y
// desenfoque, más una reacción de paralaje muy contenida al puntero.
// Es la base obligatoria y el fallback cuando WebGL2 no está disponible.
---

<div
  class="hero-2_5d absolute inset-0 overflow-hidden"
  aria-hidden="true"
  data-hero-parallax
>
  <div
    class="absolute inset-0 bg-cover bg-center scale-110 blur-[1px]"
    style="background-image: url('/images/bach-flowers/Rock%20Rose%20(Helianthemum%20nummularium).jpg');"
    data-parallax-layer="0.02"
  >
  </div>

  <img
    src="/images/bach-flowers/Wild%20Rose%20(Rosa%20canina).jpg"
    alt=""
    class="absolute -left-16 bottom-0 h-72 w-72 rounded-full object-cover opacity-70 mix-blend-multiply md:h-96 md:w-96"
    data-parallax-layer="0.05"
    loading="eager"
  />

  <img
    src="/images/bach-flowers/Gorse%20(Ulex%20europaeus).jpeg"
    alt=""
    class="absolute -right-10 top-10 h-56 w-56 rounded-full object-cover opacity-60 mix-blend-multiply md:h-80 md:w-80"
    data-parallax-layer="0.08"
    loading="eager"
  />

  <div
    class="absolute inset-0 bg-gradient-to-t from-paper via-paper/70 to-paper/10"
  >
  </div>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    .hero-2_5d [data-parallax-layer] {
      transform: none !important;
    }
  }
</style>

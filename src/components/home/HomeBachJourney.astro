---
import type { HomeTimelineItem } from "../../data/home-page";

interface Props {
  principles: readonly string[];
  timeline: HomeTimelineItem[];
}

const { principles, timeline } = Astro.props;
---

<section class="mx-auto mt-24 max-w-5xl px-6 md:px-12" data-reveal>
  <div class="max-w-2xl space-y-3">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-moss-text">
      El camino de Edward Bach
    </p>
    <h2 class="font-serif text-3xl font-bold text-ink md:text-4xl">
      De la medicina a los doce curadores
    </h2>
    <p class="text-ink/75 leading-relaxed">
      {principles[0]} {principles[1]}
    </p>
  </div>

  <ol class="relative mt-10 space-y-8 border-l border-moss/25 pl-8">
    {
      timeline.map((item) => (
        <li class="relative">
          <span class="absolute -left-[2.35rem] top-1 h-3 w-3 rounded-full bg-pollen" />
          <p class="font-serif text-2xl font-bold text-ink">{item.year}</p>
          <p class="mt-1 font-semibold text-ink/90">{item.title}</p>
          <p class="mt-1 max-w-xl text-sm leading-relaxed text-ink/70">
            {item.text}
          </p>
        </li>
      ))
    }
  </ol>

  <a
    href="/biografia"
    class="mt-8 inline-flex items-center rounded-full border border-moss/30 px-5 py-2 text-sm font-semibold text-ink transition-colors hover:bg-moss/10"
  >
    Leer la biografía completa
  </a>
</section>

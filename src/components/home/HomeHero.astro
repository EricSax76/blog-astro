---
// Umbral de la portada del blog. Sin fotografía: el elemento visual es el
// arco de años del cuaderno (2011 → hoy), en el mismo lenguaje tipográfico
// que la cabecera del anuario (numerales grandes en serif).
import { NEWEST_ARCHIVE_YEAR, OLDEST_ARCHIVE_YEAR } from "../../data/archive";
---

<section
  class="relative flex min-h-[80svh] items-center overflow-hidden bg-paper md:min-h-[88svh]"
>
  <p
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 select-none whitespace-nowrap text-center font-serif font-bold leading-none tracking-tighter text-ink/[0.05]"
    style="font-size: clamp(6rem, 19vw, 17rem);"
  >
    {`${OLDEST_ARCHIVE_YEAR} — ${NEWEST_ARCHIVE_YEAR}`}
  </p>

  <div
    class="relative z-10 mx-auto flex max-w-3xl flex-col items-start gap-6 px-6 py-24 md:px-12"
    data-reveal
  >
    <p
      class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.35em] text-moss-text"
    >
      <span class="inline-block h-px w-10 bg-pollen" aria-hidden="true"></span>
      El Alma de las Flores · Cuaderno de campo
    </p>
    <h1 class="font-serif text-4xl font-bold leading-tight text-ink md:text-6xl">
      Lo que las flores nos hacen escribir
    </h1>
    <p class="max-w-xl text-lg leading-relaxed text-ink/75">
      Un cuaderno colectivo sobre las Flores de Bach: experiencias, lecturas
      y voces de quienes recorren este jardín, año tras año, desde{" "}
      {OLDEST_ARCHIVE_YEAR}.
    </p>

    <div class="flex flex-wrap gap-3 pt-2">
      <a
        href={`/archivo/${NEWEST_ARCHIVE_YEAR}`}
        class="rounded-full bg-ink px-6 py-3 font-semibold text-cream transition-colors hover:bg-ink/90"
      >
        Leer el anuario {NEWEST_ARCHIVE_YEAR}
      </a>
      <a
        href="#cuaderno-vivo"
        class="rounded-full border border-moss/40 px-6 py-3 font-semibold text-ink transition-colors hover:bg-moss/10"
      >
        Últimas entradas
      </a>
    </div>
  </div>

  <a
    href="#cuaderno-vivo"
    class="absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-xs font-semibold uppercase tracking-[0.3em] text-ink/60 transition-colors hover:text-ink"
  >
    Desciende para leer
    <span aria-hidden="true" class="text-lg leading-none">↓</span>
  </a>
</section>

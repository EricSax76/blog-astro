---
import HeroBotanicalFallback from "./hero/HeroBotanicalFallback.astro";

interface Props {
  newestArchiveYear: number;
}

const { newestArchiveYear } = Astro.props;

// Spike comparativo Fase 2 (§5 del plan): el sitio es estático, así que
// la variante no puede decidirse en build. La base 2.5D siempre se
// renderiza; el loader de Three.js (cargado siempre, como chunk aparte)
// decide en cliente si monta la escena 3D encima según ?hero=3d en la
// URL. Sin querystring, o si WebGL2/ahorro de datos no lo permiten, solo
// se ve el 2.5D.
---

<section
  class="relative flex min-h-[85svh] items-center overflow-hidden bg-paper md:min-h-[92svh]"
>
  <div class="absolute inset-0" data-hero-3d-container>
    <HeroBotanicalFallback />

    <canvas
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700"
      aria-hidden="true"
      data-hero-3d-canvas
    ></canvas>
  </div>

  <div
    class="relative z-10 mx-auto flex max-w-3xl flex-col items-start gap-6 px-6 py-24 md:px-12"
    data-reveal
  >
    <p class="text-xs font-semibold uppercase tracking-[0.35em] text-ink/60">
      El Alma de las Flores
    </p>
    <h1 class="font-serif text-4xl font-bold leading-tight text-ink md:text-6xl">
      Hay flores que empiezan por dentro
    </h1>
    <p class="max-w-xl text-lg leading-relaxed text-ink/75">
      Un estudio vivo de las 38 Flores de Bach: su historia, la figura de
      Edward Bach y las publicaciones de quienes recorren este jardín con
      nosotros.
    </p>

    <div class="flex flex-wrap gap-3 pt-2">
      <a
        href="/flores-de-bach"
        class="rounded-full bg-ink px-6 py-3 font-semibold text-cream transition-colors hover:bg-ink/90"
      >
        Explorar las 38 flores
      </a>
      <a
        href={`/archivo/${newestArchiveYear}`}
        class="rounded-full border border-moss/40 px-6 py-3 font-semibold text-ink transition-colors hover:bg-moss/10"
      >
        Leer el último cuaderno
      </a>
    </div>
  </div>

  <a
    href="#brujula-emocional"
    class="absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-2 text-xs font-semibold uppercase tracking-[0.3em] text-ink/60 transition-colors hover:text-ink"
  >
    Desciende para explorar
    <span aria-hidden="true" class="text-lg leading-none">↓</span>
  </a>
</section>

<script src="../../scripts/home/hero-parallax.ts"></script>
<script src="../../scripts/home/hero-scene-3d-loader.ts"></script>

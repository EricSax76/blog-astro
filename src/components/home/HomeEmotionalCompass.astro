---
import { EMOTIONAL_GROUPS } from "../../data/emotional-groups";
import { flowers } from "../../data/flowers";

const groupsWithCount = EMOTIONAL_GROUPS.map((group, index) => ({
  ...group,
  index: index + 1,
  count: flowers.filter((flower) => flower.emotionalGroup === group.slug).length,
}));
---

<section id="brujula-emocional" class="emotional-compass" data-reveal>
  <header class="compass-intro">
    <div>
      <p class="compass-kicker">Brújula emocional</p>
      <h2>Siete rumbos para reconocerte</h2>
    </div>
    <p class="compass-lead">
      No necesitas saber el nombre exacto de lo que sientes. Acércate al rumbo
      que más se parezca a tu momento de hoy.
    </p>
  </header>

  <div class="compass-map">
    <div class="compass-orbit" aria-hidden="true">
      <span class="orbit orbit-outer"></span>
      <span class="orbit orbit-inner"></span>
      <span class="axis axis-horizontal"></span>
      <span class="axis axis-vertical"></span>
    </div>

    <div class="compass-heart" aria-hidden="true">
      <span class="heart-eyebrow">Punto de partida</span>
      <span class="heart-question">¿Qué estás<br />sintiendo hoy?</span>
      <svg viewBox="0 0 28 39" role="presentation">
        <path d="M14 1v37M1 20h26" />
        <path d="m14 1 3 16-3 3-3-3 3-16Z" />
      </svg>
    </div>

    <ul class="compass-directions">
      {
        groupsWithCount.map((group) => (
          <li class={`direction direction-${group.index}`}>
            <a href={`/flores-de-bach?grupo=${group.slug}`}>
              <span class="direction-number" aria-hidden="true">
                {String(group.index).padStart(2, "0")}
              </span>
              <span class="direction-copy">
                <span class="direction-meta">
                  {group.count} {group.count === 1 ? "flor" : "flores"}
                </span>
                <span class="direction-title">{group.label}</span>
                <span class="direction-description">{group.description}</span>
                <span class="direction-action" aria-hidden="true">
                  Explorar este rumbo <span>↗</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .emotional-compass {
    width: min(100% - 3rem, 76rem);
    margin: clamp(6rem, 10vw, 9rem) auto 0;
    color: var(--color-ink);
  }

  .compass-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    align-items: end;
    gap: 4rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-moss) 38%, transparent);
  }

  .compass-kicker {
    margin: 0 0 0.75rem;
    color: var(--color-moss-text);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 35rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 4vw, 4rem);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .compass-lead {
    max-width: 31rem;
    margin: 0;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    font-size: 0.94rem;
    line-height: 1.75;
  }

  .compass-map {
    position: relative;
    min-height: 52rem;
    margin-top: 1.5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .compass-orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .orbit,
  .axis {
    position: absolute;
    display: block;
    opacity: 0.6;
  }

  .orbit {
    left: 50%;
    top: 50%;
    border: 1px solid color-mix(in srgb, var(--color-moss) 29%, transparent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .orbit-outer {
    width: 33rem;
    height: 33rem;
  }

  .orbit-inner {
    width: 24rem;
    height: 24rem;
    border-style: dashed;
  }

  .axis-horizontal {
    left: calc(50% - 20rem);
    top: 50%;
    width: 40rem;
    border-top: 1px solid color-mix(in srgb, var(--color-moss) 25%, transparent);
  }

  .axis-vertical {
    left: 50%;
    top: calc(50% - 20rem);
    height: 40rem;
    border-left: 1px solid color-mix(in srgb, var(--color-moss) 25%, transparent);
  }

  .compass-heart {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    display: flex;
    width: 15.5rem;
    aspect-ratio: 1;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--color-moss) 52%, transparent);
    border-radius: 50%;
    background:
      radial-gradient(circle at 42% 32%, rgb(255 255 255 / 55%), transparent 42%),
      var(--color-paper-dim);
    box-shadow: 0 1.5rem 4rem rgb(44 85 48 / 7%);
    text-align: center;
    transform: translate(-50%, -50%);
  }

  .heart-eyebrow {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .heart-question {
    margin-top: 0.55rem;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.05;
  }

  .compass-heart svg {
    width: 1.35rem;
    margin-top: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.8;
  }

  .compass-directions {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .direction {
    position: absolute;
    width: 17.5rem;
  }

  .direction-1 { left: 1%; top: 8%; }
  .direction-2 { left: 50%; top: 4%; transform: translateX(-50%); }
  .direction-3 { right: 0; top: 8%; }
  .direction-4 { left: 0; top: 42%; }
  .direction-5 { right: 0; top: 42%; }
  .direction-6 { left: 11%; bottom: 3%; }
  .direction-7 { right: 9%; bottom: 3%; }

  .direction a {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.8rem;
    color: inherit;
    text-decoration: none;
  }

  .direction-number {
    padding-top: 0.3rem;
    color: color-mix(in srgb, var(--color-moss-text) 70%, transparent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .direction-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .direction-meta {
    color: var(--color-moss-text);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .direction-title {
    margin-top: 0.18rem;
    font-family: var(--font-serif);
    font-size: 1.38rem;
    font-weight: 650;
    line-height: 1.08;
    text-wrap: balance;
  }

  .direction-description {
    max-width: 15rem;
    margin-top: 0.42rem;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
    font-size: 0.73rem;
    line-height: 1.55;
  }

  .direction-action {
    margin-top: 0.7rem;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-moss) 55%, transparent);
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(0.25rem);
    transition:
      opacity var(--duration-hover) ease,
      transform var(--duration-hover) ease,
      border-color var(--duration-hover) ease;
  }

  .direction-action span {
    display: inline-block;
    margin-left: 0.25rem;
    transition: transform var(--duration-hover) ease;
  }

  .direction a:hover .direction-action,
  .direction a:focus-visible .direction-action {
    opacity: 1;
    transform: none;
  }

  .direction a:hover .direction-action span,
  .direction a:focus-visible .direction-action span {
    transform: translate(0.15rem, -0.15rem);
  }

  .direction a:hover .direction-title,
  .direction a:focus-visible .direction-title {
    color: color-mix(in srgb, var(--color-ink) 78%, var(--color-pollen));
  }

  .direction a:focus-visible {
    outline: 2px solid var(--color-pollen);
    outline-offset: 0.45rem;
    border-radius: 0.2rem;
  }

  @media (max-width: 900px) {
    .compass-map { min-height: 58rem; }
    .direction { width: 14rem; }
    .direction-1 { left: 0; }
    .direction-3 { right: 0; }
    .direction-6 { left: 3%; }
    .direction-7 { right: 3%; }
    .orbit-outer { width: 29rem; height: 29rem; }
    .orbit-inner { width: 21rem; height: 21rem; }
  }

  @media (max-width: 700px) {
    .emotional-compass {
      width: min(100% - 2rem, 34rem);
      margin-top: 5.5rem;
    }

    .compass-intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    h2 { font-size: clamp(2.5rem, 12vw, 3.5rem); }

    .compass-map {
      min-height: auto;
      margin-top: 2.25rem;
      overflow: visible;
    }

    .compass-orbit { display: none; }

    .compass-heart {
      position: relative;
      left: auto;
      top: auto;
      width: 12.5rem;
      margin: 0 auto 3rem;
      transform: none;
    }

    .compass-directions {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .compass-directions::before {
      position: absolute;
      left: 50%;
      top: -3rem;
      bottom: 1rem;
      width: 1px;
      background: color-mix(in srgb, var(--color-moss) 38%, transparent);
      content: "";
    }

    .direction,
    .direction-1,
    .direction-2,
    .direction-3,
    .direction-4,
    .direction-5,
    .direction-6,
    .direction-7 {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      width: 50%;
      min-height: 10.75rem;
      padding: 0 1.5rem 2rem 0;
      transform: none;
    }

    .direction:nth-child(even) {
      align-self: flex-end;
      padding: 0 0 2rem 1.5rem;
    }

    .direction::after {
      position: absolute;
      right: -0.28rem;
      top: 0.2rem;
      width: 0.55rem;
      height: 0.55rem;
      border: 2px solid var(--color-paper);
      border-radius: 50%;
      background: var(--color-moss-text);
      box-shadow: 0 0 0 1px var(--color-moss-text);
      content: "";
    }

    .direction:nth-child(even)::after {
      left: -0.27rem;
      right: auto;
    }

    .direction a {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .direction-number { padding: 0; }
    .direction-title { font-size: 1.23rem; }
    .direction-description { font-size: 0.7rem; }
    .direction-action { display: none; }
  }
</style>

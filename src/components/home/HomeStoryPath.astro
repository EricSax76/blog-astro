---
// Cuaderno vivo: las publicaciones recientes que siguen a las del hero
// (que ya muestra la última y las siguientes). Se pintan primero en rejilla
// (fallback y estado sin JS/movimiento) y, si es posible, pasan al camino 3D
// (scripts/home/story-path.ts). El visor tiene altura normal y se recorre
// por paradas: el scroll de la página pasa de largo sin quedar atrapado.
interface Props {
  newestArchiveYear: number;
}

const { newestArchiveYear } = Astro.props;
---

<section
  id="cuaderno-vivo"
  class="mx-auto mt-24 max-w-6xl scroll-mt-24 px-6 md:px-12"
  data-story-path
  data-newest-year={newestArchiveYear}
>
  <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
    <div class="space-y-2">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-moss-text">
        Cuaderno vivo
      </p>
      <h2 class="font-serif text-3xl font-bold text-ink md:text-4xl">
        Sigue el sendero del cuaderno
      </h2>
    </div>
    <a
      href={`/archivo/${newestArchiveYear}`}
      class="rounded-full border border-moss/30 px-5 py-2 text-sm font-semibold text-ink transition-colors hover:bg-moss/10"
    >
      Ir al anuario {newestArchiveYear}
    </a>
  </div>

  <p id="story-path-loading" class="mt-10 text-sm text-ink/60" aria-live="polite">
    Cargando publicaciones recientes…
  </p>

  <!-- Rejilla 2D: siempre se rellena; es el punto de partida y el fallback. -->
  <div
    id="story-path-grid"
    class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3"
    aria-live="polite"
  >
  </div>

  <!-- Camino 3D: oculto hasta que story-path.ts lo activa. -->
  <div id="story-path-track" class="mt-10 hidden">
    <!-- overflow-clip (no hidden): el foco de teclado no puede desplazar el
         visor por dentro y descolocar la escena. -->
    <div
      id="story-path-stage"
      class="relative h-[min(72svh,38rem)] min-h-[28rem] touch-pan-y overflow-clip overscroll-x-contain rounded-[2rem] border border-moss/15 bg-paper-dim/50"
    >
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_45%,rgb(236_230_214/0.9)_100%)]"
      ></div>
      <div id="story-path-scene" class="absolute inset-0"></div>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-between gap-4 px-5 pb-4 text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-moss-text md:px-6 md:pb-5"
      >
        <p id="story-path-counter" class="shrink-0 whitespace-nowrap" aria-live="polite">
          1 / 1
        </p>
        <p
          id="story-path-hint"
          class="hidden whitespace-nowrap transition-opacity duration-500 sm:block"
        >
          Desliza o usa las flechas
        </p>
        <div class="pointer-events-auto flex shrink-0 gap-2">
          <button
            id="story-path-prev"
            type="button"
            aria-label="Entrada anterior"
            class="story-path-nav"
          >
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M12.5 4.5 7 10l5.5 5.5"></path>
            </svg>
          </button>
          <button
            id="story-path-next"
            type="button"
            aria-label="Entrada siguiente"
            class="story-path-nav"
          >
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
              <path d="M7.5 4.5 13 10l-5.5 5.5"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Tarjetas dentro de la escena: ancho fijo (la perspectiva hace el resto),
     sin transiciones de layout; solo opacidad y foco. */
  #story-path-scene .story-card {
    width: var(--story-card-width, min(400px, calc(100vw - 4rem)));
    transition:
      opacity 180ms linear,
      box-shadow 300ms var(--ease-garden),
      border-color 300ms var(--ease-garden);
    backface-visibility: hidden;
  }

  #story-path-scene .story-card--end {
    width: min(340px, var(--story-card-width, calc(100vw - 5rem)));
  }

  #story-path-scene .story-card.is-focal {
    border-color: color-mix(in srgb, var(--color-pollen) 70%, transparent);
    box-shadow: 0 32px 60px -24px rgb(44 85 48 / 0.35);
  }

  .story-path-nav {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-moss) 35%, transparent);
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    color: var(--color-ink);
    box-shadow: 0 6px 16px -10px rgb(44 85 48 / 0.4);
    transition:
      background-color var(--duration-hover) var(--ease-garden),
      opacity var(--duration-hover) var(--ease-garden);
  }

  .story-path-nav:hover:not(:disabled) {
    background: var(--color-paper);
  }

  .story-path-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .story-path-nav:focus-visible {
    outline: 2px solid var(--color-pollen);
    outline-offset: 2px;
  }

  #story-path-scene .story-card:focus-within {
    outline: 2px solid var(--color-pollen);
    outline-offset: 4px;
  }
</style>

<script src="../../scripts/home/story-path.ts"></script>

---
import type { HomeFeaturedFlower } from "../../data/home-page";

interface Props {
  featuredFlowers: HomeFeaturedFlower[];
}

const { featuredFlowers } = Astro.props;
const [dominant, ...secondary] = featuredFlowers;
---

<section class="mx-auto mt-24 max-w-6xl px-6 md:px-12" data-reveal>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="space-y-2">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-moss-text">
        Atlas del herbario
      </p>
      <h2 class="font-serif text-3xl font-bold text-ink md:text-4xl">
        Láminas para empezar a recorrer el jardín
      </h2>
    </div>
    <a
      href="/flores-de-bach"
      class="rounded-full border border-moss/30 px-5 py-2 text-sm font-semibold text-ink transition-colors hover:bg-moss/10"
    >
      Ver las 38 flores
    </a>
  </div>

  {
    dominant && (
      <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
        <a
          href={`/flores-de-bach/${dominant.slug}`}
          class="group relative block overflow-hidden rounded-[2rem] border border-moss/15"
        >
          <img
            src={dominant.img}
            alt={`Flor de Bach ${dominant.name}`}
            class="h-80 w-full object-cover transition-transform duration-700 group-hover:scale-105 lg:h-full"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent" />
          <div class="absolute inset-x-0 bottom-0 space-y-1 p-6 text-cream opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
            <p class="text-xs italic text-cream/70">{dominant.botanical}</p>
            <p class="text-sm leading-relaxed text-cream/90">
              {dominant.summary}
            </p>
          </div>
          <div class="absolute left-6 top-6 space-y-1">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-cream/80">
              Esencia {dominant.id}
            </p>
            <h3 class="font-serif text-3xl font-bold text-cream">
              {dominant.name}
            </h3>
          </div>
        </a>

        <div class="grid grid-cols-2 gap-4 lg:grid-cols-1">
          {secondary.map((flower) => (
            <a
              href={`/flores-de-bach/${flower.slug}`}
              class="group relative block overflow-hidden rounded-3xl border border-moss/15"
            >
              <img
                src={flower.img}
                alt={`Flor de Bach ${flower.name}`}
                class="h-36 w-full object-cover transition-transform duration-700 group-hover:scale-105 lg:h-28"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/5 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-3">
                <p class="font-serif text-lg font-bold text-cream">
                  {flower.name}
                </p>
                <p class="text-xs italic text-cream/70 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100">
                  {flower.botanical}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )
  }
</section>

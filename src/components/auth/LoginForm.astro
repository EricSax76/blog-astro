<section id="login" class="space-y-4">
  <h4 class="font-serif text-2xl font-semibold text-deep-green">Iniciar sesión</h4>
  <form id="login-form" class="space-y-4">
    <label class="block space-y-2">
      <span
        class="text-xs uppercase tracking-[0.2em] text-deep-green/60 font-semibold"
      >
        Correo
      </span>
      <input
        id="login-email"
        type="email"
        name="email"
        autocomplete="email"
        required
        aria-required="true"
        aria-invalid="false"
        aria-describedby="login-email-error"
        placeholder="nombre@correo.com"
        class="w-full rounded-2xl border border-sage/30 bg-cream/60 px-4 py-3 text-deep-green placeholder:text-deep-green/40 focus:outline-none focus:ring-2 focus:ring-sage/40 aria-[invalid=true]:border-red-400 aria-[invalid=true]:focus:ring-red-300"
      />
      <p id="login-email-error" class="text-xs text-red-600 mt-1" aria-live="polite"></p>
    </label>

    <label class="block space-y-2">
      <span
        class="text-xs uppercase tracking-[0.2em] text-deep-green/60 font-semibold"
      >
        Contraseña
      </span>
      <input
        id="login-password"
        type="password"
        name="password"
        autocomplete="current-password"
        required
        aria-required="true"
        aria-invalid="false"
        aria-describedby="login-password-error"
        placeholder="Tu contraseña"
        class="w-full rounded-2xl border border-sage/30 bg-cream/60 px-4 py-3 text-deep-green placeholder:text-deep-green/40 focus:outline-none focus:ring-2 focus:ring-sage/40 aria-[invalid=true]:border-red-400 aria-[invalid=true]:focus:ring-red-300"
      />
      <p id="login-password-error" class="text-xs text-red-600 mt-1" aria-live="polite"></p>
    </label>

    <button
      type="submit"
      class="w-full rounded-full border border-sage/40 px-6 py-3 text-deep-green font-semibold hover:bg-sage/10 transition-colors"
    >
      Entrar al panel
    </button>
  </form>

  <div class="flex items-center gap-3" aria-hidden="true">
    <span class="h-px flex-1 bg-sage/20"></span>
    <span class="text-xs uppercase tracking-[0.2em] text-deep-green/40">o</span>
    <span class="h-px flex-1 bg-sage/20"></span>
  </div>

  <button
    id="google-login-button"
    type="button"
    class="w-full flex items-center justify-center gap-3 rounded-full border border-sage/40 bg-white px-6 py-3 text-deep-green font-semibold hover:bg-sage/10 transition-colors"
  >
    <svg viewBox="0 0 48 48" class="h-5 w-5" aria-hidden="true">
      <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34.4 5.1 29.5 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.4-.1-2.7-.4-3.5z"/>
      <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.6 15.9 18.9 13 24 13c3.1 0 5.8 1.1 8 3l6-6C34.4 5.1 29.5 3 24 3c-7.5 0-14 4.2-17.3 10.4z"/>
      <path fill="#4CAF50" d="M24 45c5.4 0 10.2-1.9 13.9-5.1l-6.4-5.4C29.3 36.6 26.8 37.5 24 37.5c-5.3 0-9.7-3.4-11.3-8.1l-6.6 5.1C9.9 40.6 16.4 45 24 45z"/>
      <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.4 5.4C41.4 36.4 45 31 45 24c0-1.4-.1-2.7-.4-3.5z"/>
    </svg>
    Continuar con Google
  </button>
</section>

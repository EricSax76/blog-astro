---
import { flowers } from "../../data/flowers";
import { EMOTIONAL_GROUPS } from "../../data/emotional-groups";

const GROUP_COLORS: Record<string, string> = {
  fear: "#b77c72",
  uncertainty: "#b49a63",
  "insufficient-interest": "#8c9a84",
  loneliness: "#7f94a0",
  oversensitivity: "#a98696",
  "despondency-despair": "#8a839f",
  "over-care-for-others": "#a8836c",
};

const gardenData = {
  flowers,
  groups: EMOTIONAL_GROUPS.map((group) => ({
    ...group,
    color: GROUP_COLORS[group.slug],
  })),
};
---

<section class="garden-shell" data-bach-garden data-day-period="day">
  <div class="garden-intro">
    <div>
      <p class="eyebrow"><span></span> Cartografía emocional · 38 esencias</p>
      <h1>Recorre el paisaje<br /><em>que llevas dentro</em></h1>
    </div>
    <p class="garden-lede">
      Cada zona reúne un estado del alma. La luz cambia con la hora local para
      que la exploración respire con el día, sin ruido visual.
    </p>
  </div>

  <div class="garden-stage" data-garden-stage>
    <canvas data-garden-canvas aria-hidden="true"></canvas>

    <div class="garden-atmosphere" aria-hidden="true"></div>

    <div class="garden-toolbar" aria-label="Controles del jardín">
      <button class="soundless-compass" type="button" data-reset-view aria-label="Volver a la vista general">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <circle cx="24" cy="24" r="18"></circle>
          <path d="m29 19-3.2 6.8L19 29l3.2-6.8z"></path>
        </svg>
        <span>Vista general</span>
      </button>

      <button class="list-toggle" type="button" data-list-toggle aria-expanded="false" aria-controls="flower-list">
        <span aria-hidden="true">☷</span> Ver índice
      </button>
    </div>

    <div class="garden-time" data-garden-time aria-live="polite">
      <time data-garden-clock datetime="">--:--</time>
      <span data-garden-daypart>Hora local</span>
    </div>

    <div class="garden-instruction" data-garden-instruction>
      <span class="mouse-mark" aria-hidden="true"></span>
      Recorre el paisaje · acércate a una emoción
    </div>

    <div class="garden-tooltip" data-garden-tooltip role="status" aria-live="polite"></div>

    <aside class="flower-story" data-flower-story aria-live="polite" aria-hidden="true">
      <button type="button" class="story-close" data-story-close aria-label="Cerrar la ficha">×</button>
      <p class="story-count" data-story-count></p>
      <div class="story-image-wrap">
        <img data-story-image src="" alt="" />
      </div>
      <div class="story-copy">
        <p class="story-group" data-story-group></p>
        <h2 data-story-name></h2>
        <p class="story-botanical" data-story-botanical></p>
        <p class="story-description" data-story-description></p>
        <div class="story-quality">
          <span>La cualidad que despierta</span>
          <p data-story-positive></p>
        </div>
        <a class="story-link" data-story-link href="/flores-de-bach">
          Leer su ficha completa <span aria-hidden="true">↗</span>
        </a>
      </div>
    </aside>

    <div class="webgl-note" data-webgl-note hidden>
      <p>Tu navegador no puede mostrar el jardín 3D.</p>
      <button type="button" data-open-list>Explorar el índice botánico</button>
    </div>
  </div>

  <nav class="group-legend" aria-label="Explorar por grupo emocional">
    <button type="button" class="legend-item is-active" data-group="all" aria-pressed="true">
      <span class="legend-dot all"></span>
      <span><strong>Jardín completo</strong><small>Las 38 flores</small></span>
    </button>
    {gardenData.groups.map((group) => (
      <button type="button" class="legend-item" data-group={group.slug} aria-pressed="false">
        <span class="legend-dot" style={`--dot:${group.color}`}></span>
        <span><strong>{group.label}</strong><small>{flowers.filter((flower) => flower.emotionalGroup === group.slug).length} flores</small></span>
      </button>
    ))}
  </nav>

  <div class="flower-index" id="flower-list" data-flower-list hidden>
    <div class="index-heading">
      <div>
        <p class="eyebrow"><span></span> Índice botánico</p>
        <h2>Las 38 flores</h2>
      </div>
      <button type="button" data-list-close aria-label="Cerrar el índice">Cerrar ×</button>
    </div>
    <div class="index-grid">
      {flowers.map((flower) => (
        <button type="button" class="index-flower" data-index-flower={flower.slug} data-index-group={flower.emotionalGroup}>
          <span class="index-number">{String(flower.id).padStart(2, "0")}</span>
          <img src={flower.img} alt="" loading="lazy" />
          <span><strong>{flower.name}</strong><small>{flower.botanical}</small></span>
          <span class="index-arrow" aria-hidden="true">↗</span>
        </button>
      ))}
    </div>
  </div>

  <script is:inline id="bach-garden-data" type="application/json" set:html={JSON.stringify(gardenData)}></script>
</section>

<script src="../../scripts/flowers/bach-garden.ts"></script>

<style>
  .garden-shell {
    --pollen: #a58a4e;
    --shell-bg: #eceadb;
    --stage-top: #e9e7d6;
    --stage-middle: #dcdcc8;
    --stage-bottom: #ccd0ba;
    --stage-line: rgb(61 70 52 / 22%);
    --stage-veil-top: rgb(255 253 244 / 50%);
    --stage-veil-bottom: rgb(163 168 140 / 30%);
    --stage-vignette: rgb(130 138 112 / 22%);
    --stage-shade: rgb(120 128 104 / 12%);
    --stage-shadow: rgb(96 106 84 / 20%);
    --grid-line: rgb(53 64 47 / 5%);
    --title: #333e2d;
    --title-em: #7c8763;
    --soft-text: #49523f;
    --muted-text: #6d7660;
    --hover-bg: rgb(61 70 52 / 7%);
    --button-text: #3a4234;
    --button-border: rgb(61 70 52 / 26%);
    --button-bg: rgb(252 250 241 / 66%);
    --button-hover: rgb(255 254 248 / 88%);
    --tooltip-text: #333d2e;
    --tooltip-bg: rgb(250 248 239 / 92%);
    --panel-paper: #f1eadc;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: -3rem;
    color: var(--soft-text);
    background: var(--shell-bg);
    overflow: hidden;
    transition: background-color 1.2s ease, color 1.2s ease;
  }

  .garden-shell[data-day-period="dawn"] {
    --pollen: #ab8746;
    --shell-bg: #ece2cd;
    --stage-top: #ede3ce;
    --stage-middle: #e0d4ba;
    --stage-bottom: #cfc2a4;
    --stage-line: rgb(90 78 52 / 22%);
    --stage-veil-top: rgb(255 246 227 / 50%);
    --stage-veil-bottom: rgb(163 148 114 / 30%);
    --stage-vignette: rgb(142 122 88 / 24%);
    --stage-shade: rgb(134 116 84 / 12%);
    --stage-shadow: rgb(112 96 68 / 20%);
    --grid-line: rgb(74 62 40 / 5%);
    --title: #453c28;
    --title-em: #8d7f58;
    --soft-text: #55492f;
    --muted-text: #7a6c4c;
    --hover-bg: rgb(90 78 52 / 8%);
    --button-text: #4a4028;
    --button-border: rgb(90 78 52 / 26%);
    --button-bg: rgb(255 249 236 / 66%);
    --button-hover: rgb(255 252 243 / 88%);
    --tooltip-text: #43391f;
    --tooltip-bg: rgb(253 247 234 / 92%);
  }

  .garden-shell[data-day-period="dusk"] {
    --pollen: #9a7434;
    --shell-bg: #cfb69b;
    --stage-top: #d3ba9f;
    --stage-middle: #c3a687;
    --stage-bottom: #a98e6f;
    --stage-line: rgb(74 56 34 / 26%);
    --stage-veil-top: rgb(250 224 184 / 42%);
    --stage-veil-bottom: rgb(118 94 66 / 32%);
    --stage-vignette: rgb(108 84 56 / 30%);
    --stage-shade: rgb(118 92 62 / 16%);
    --stage-shadow: rgb(96 74 48 / 26%);
    --grid-line: rgb(66 48 26 / 6%);
    --title: #42301c;
    --title-em: #86683f;
    --soft-text: #4e3b25;
    --muted-text: #71583a;
    --hover-bg: rgb(74 56 34 / 9%);
    --button-text: #45341f;
    --button-border: rgb(74 56 34 / 30%);
    --button-bg: rgb(252 238 216 / 60%);
    --button-hover: rgb(255 245 228 / 84%);
    --tooltip-text: #3e2e1a;
    --tooltip-bg: rgb(252 240 220 / 92%);
  }

  .garden-shell[data-day-period="night"] {
    --pollen: #a8a07f;
    --shell-bg: #111821;
    --stage-top: #141b24;
    --stage-middle: #1b222a;
    --stage-bottom: #0e1218;
    --stage-line: rgb(210 218 222 / 13%);
    --stage-veil-top: rgb(12 17 23 / 48%);
    --stage-veil-bottom: rgb(5 8 12 / 62%);
    --stage-vignette: rgb(3 6 10 / 46%);
    --stage-shade: rgb(0 0 0 / 22%);
    --stage-shadow: rgb(0 0 0 / 45%);
    --grid-line: rgb(255 255 255 / 2.5%);
    --title: #f3ecdc;
    --title-em: #c3b79d;
    --soft-text: #d1d5d7;
    --muted-text: #a5adb2;
    --hover-bg: rgb(255 255 255 / 5%);
    --button-text: #eee9de;
    --button-border: rgb(232 226 212 / 20%);
    --button-bg: rgb(16 23 31 / 70%);
    --button-hover: rgb(39 48 57 / 78%);
    --tooltip-text: #f8f3e7;
    --tooltip-bg: rgb(15 20 22 / 88%);
  }

  .garden-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(17rem, .6fr);
    align-items: end;
    gap: 3rem;
    max-width: 90rem;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 7rem) clamp(1.5rem, 6vw, 6rem) 2.5rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin: 0 0 1.2rem;
    color: var(--muted-text);
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .24em;
    text-transform: uppercase;
  }

  .eyebrow span { width: 2.5rem; height: 1px; background: var(--pollen); }

  h1, h2 { font-family: "Cormorant Garamond", serif; }

  h1 {
    margin: 0;
    max-width: 15ch;
    color: var(--title);
    font-size: clamp(3.25rem, 7.3vw, 7rem);
    font-weight: 500;
    line-height: .82;
    transition: color 1.2s ease;
  }

  h1 em { color: var(--title-em); font-weight: 400; }

  .garden-lede {
    max-width: 29rem;
    margin: 0 0 .7rem;
    padding-left: 1.5rem;
    border-left: 1px solid color-mix(in srgb, var(--pollen) 48%, transparent);
    color: var(--soft-text);
    font-size: clamp(.95rem, 1.3vw, 1.1rem);
    line-height: 1.75;
  }

  .garden-stage {
    position: relative;
    height: min(70rem, 78svh);
    min-height: 37rem;
    max-width: 100rem;
    margin: 0 auto;
    overflow: hidden;
    border-block: 1px solid var(--stage-line);
    background:
      linear-gradient(180deg, var(--stage-top), var(--stage-middle) 45%, var(--stage-bottom));
    transition: background 1.2s ease, border-color 1.2s ease;
  }

  [data-garden-canvas] { position: absolute; inset: 0; width: 100%; height: 100%; cursor: grab; }
  [data-garden-canvas].is-dragging { cursor: grabbing; }
  [data-garden-canvas].has-target { cursor: pointer; }

  .garden-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, var(--stage-veil-top), transparent 28%, transparent 72%, var(--stage-veil-bottom)),
      linear-gradient(90deg, var(--stage-shade), transparent 18%, transparent 82%, var(--stage-shade)),
      radial-gradient(ellipse at 50% 54%, transparent 22%, var(--stage-vignette) 86%);
    box-shadow: inset 0 0 7rem var(--stage-shadow);
  }

  .garden-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .28;
    background-image:
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px),
      linear-gradient(180deg, var(--grid-line) 1px, transparent 1px);
    background-size: 5.5rem 5.5rem;
    mask-image: linear-gradient(180deg, transparent, #000 18%, #000 84%, transparent);
  }

  .garden-toolbar { position: absolute; top: 1.4rem; left: 1.4rem; display: flex; gap: .75rem; }
  .garden-toolbar button, .list-toggle {
    display: flex; align-items: center; gap: .55rem; min-height: 2.8rem; padding: .55rem .9rem;
    border: 1px solid var(--button-border); border-radius: 999px;
    color: var(--button-text); background: var(--button-bg); backdrop-filter: blur(12px);
    font-size: .72rem; font-weight: 600; letter-spacing: .04em; cursor: pointer;
    transition: background .2s ease, border-color .2s ease;
  }
  .garden-toolbar button:hover { background: var(--button-hover); border-color: color-mix(in srgb, var(--button-text) 40%, transparent); }
  .soundless-compass svg { width: 1.5rem; fill: none; stroke: currentColor; stroke-width: 1.2; }
  .soundless-compass svg path { fill: var(--pollen); stroke: none; }
  .list-toggle span { font-size: 1.1rem; }

  .garden-time {
    position: absolute;
    z-index: 4;
    top: 1.55rem;
    right: 1.6rem;
    display: grid;
    gap: .25rem;
    padding-left: 1rem;
    border-left: 1px solid var(--stage-line);
    color: var(--soft-text);
    text-align: right;
    pointer-events: none;
  }

  .garden-time time {
    color: var(--title);
    font-family: "Cormorant Garamond", serif;
    font-size: 1.45rem;
    line-height: 1;
  }

  .garden-time span {
    color: var(--muted-text);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .garden-instruction {
    position: absolute; left: 50%; bottom: 1.5rem; display: flex; align-items: center; gap: .7rem;
    transform: translateX(-50%); white-space: nowrap; color: var(--soft-text); font-size: .68rem;
    letter-spacing: .06em; pointer-events: none; transition: opacity .5s ease;
  }
  .mouse-mark { width: 1.05rem; height: 1.45rem; border: 1px solid color-mix(in srgb, var(--soft-text) 60%, transparent); border-radius: 999px; }
  .mouse-mark::after { content: ""; display: block; width: 2px; height: 4px; margin: 4px auto; background: var(--pollen); border-radius: 2px; }
  .garden-instruction.is-hidden { opacity: 0; }

  .garden-tooltip {
    position: absolute; z-index: 5; padding: .5rem .7rem; border: 1px solid var(--stage-line);
    border-radius: .3rem; color: var(--tooltip-text); background: var(--tooltip-bg); backdrop-filter: blur(8px);
    font-family: "Cormorant Garamond", serif; font-size: 1.05rem; pointer-events: none;
    opacity: 0; transform: translate(12px, 12px); transition: opacity .15s ease;
  }
  .garden-tooltip.is-visible { opacity: 1; }

  .flower-story {
    position: absolute; z-index: 8; top: 0; right: 0; display: grid; grid-template-columns: 42% 58%;
    width: min(54rem, 68%); height: 100%; color: #253229; background: var(--panel-paper);
    box-shadow: -2rem 0 5rem rgb(3 13 7 / 35%); transform: translateX(105%);
    transition: transform .7s cubic-bezier(.22, 1, .36, 1); overflow: hidden;
  }
  .flower-story.is-open { transform: none; }
  .story-close { position: absolute; z-index: 3; top: 1rem; right: 1rem; width: 2.7rem; height: 2.7rem; border: 1px solid rgb(31 58 43 / 25%); border-radius: 50%; color: #294735; background: rgb(244 239 225 / 80%); font-size: 1.5rem; cursor: pointer; }
  .story-count { position: absolute; z-index: 2; left: 1.25rem; top: .8rem; margin: 0; color: white; font-size: .66rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; text-shadow: 0 1px 8px #000; }
  .story-image-wrap { min-height: 100%; overflow: hidden; background: #232a25; }
  .story-image-wrap img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.72) contrast(1.02); }
  .story-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 4vw, 4.5rem); overflow-y: auto; }
  .story-group { margin: 0 0 .8rem; color: #71866d; font-size: .65rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; }
  .story-copy h2 { margin: 0; color: #203b2b; font-size: clamp(3rem, 5vw, 5.6rem); font-weight: 500; line-height: .85; }
  .story-botanical { margin: .8rem 0 1.7rem; color: #71816c; font-family: "Cormorant Garamond", serif; font-size: 1.15rem; font-style: italic; }
  .story-description { margin: 0; color: #405447; font-size: .92rem; line-height: 1.7; }
  .story-quality { margin-top: 1.7rem; padding: 1.25rem 0; border-block: 1px solid #cad1c2; }
  .story-quality span { color: #8d7443; font-size: .62rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .story-quality p { margin: .5rem 0 0; color: #294634; font-family: "Cormorant Garamond", serif; font-size: 1.25rem; line-height: 1.35; }
  .story-link { display: flex; justify-content: space-between; align-items: center; margin-top: 1.4rem; color: #294634; font-size: .76rem; font-weight: 700; text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
  .story-link span { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; color: #f2ead8; background: #294634; transition: transform .25s ease; }
  .story-link:hover span { transform: translate(2px, -2px); }

  .group-legend {
    display: grid; grid-template-columns: repeat(4, 1fr); max-width: 90rem; margin: 0 auto;
    padding: 2.2rem clamp(1.5rem, 6vw, 6rem) 3.2rem; gap: .55rem .8rem;
  }
  .legend-item { display: flex; align-items: center; gap: .7rem; padding: .7rem; border: 1px solid transparent; border-radius: .45rem; color: var(--soft-text); background: transparent; text-align: left; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .legend-item:hover, .legend-item.is-active { color: var(--title); background: var(--hover-bg); }
  .legend-item:focus-visible { outline: 2px solid var(--pollen); outline-offset: 2px; }
  .legend-dot { flex: 0 0 auto; width: .62rem; height: .62rem; border: 2px solid var(--dot); border-radius: 50%; box-shadow: 0 0 0 3px color-mix(in srgb, var(--dot) 20%, transparent); }
  .legend-dot.all { border-color: var(--pollen); background: var(--pollen); }
  .legend-item span:last-child { display: flex; flex-direction: column; }
  .legend-item strong { font-size: .7rem; font-weight: 600; line-height: 1.3; }
  .legend-item small { color: var(--muted-text); font-size: .61rem; }

  .flower-index { max-width: 90rem; margin: 0 auto; padding: 1rem clamp(1.5rem, 6vw, 6rem) 5rem; }
  .index-heading { display: flex; justify-content: space-between; align-items: end; padding-bottom: 1.5rem; border-bottom: 1px solid var(--stage-line); }
  .index-heading h2 { margin: 0; color: var(--title); font-size: clamp(2.7rem, 5vw, 4.5rem); font-weight: 500; }
  .index-heading button { border: 0; color: var(--muted-text); background: transparent; cursor: pointer; }
  .index-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .index-flower { display: grid; grid-template-columns: 2.5rem 3.2rem 1fr auto; align-items: center; gap: .8rem; min-width: 0; padding: 1rem .7rem; border: 0; border-bottom: 1px solid var(--stage-line); color: var(--soft-text); background: transparent; text-align: left; cursor: pointer; }
  .index-flower:hover { background: var(--hover-bg); }
  .index-flower.is-filtered { display: none; }
  .index-flower img { width: 3.2rem; height: 3.2rem; border-radius: 50%; object-fit: cover; }
  .index-number { color: var(--muted-text); font-family: "Cormorant Garamond", serif; font-size: 1.1rem; }
  .index-flower > span:nth-child(3) { display: flex; min-width: 0; flex-direction: column; }
  .index-flower strong { font-family: "Cormorant Garamond", serif; font-size: 1.25rem; font-weight: 500; }
  .index-flower small { overflow: hidden; color: var(--muted-text); font-size: .62rem; font-style: italic; text-overflow: ellipsis; white-space: nowrap; }
  .index-arrow { color: var(--pollen); }
  .webgl-note { position: absolute; inset: 0; z-index: 10; place-content: center; text-align: center; background: var(--shell-bg); }
  .webgl-note:not([hidden]) { display: grid; }
  .webgl-note button { margin: 0 auto; padding: .8rem 1.2rem; border: 1px solid var(--button-border); border-radius: 999px; color: var(--button-text); background: transparent; cursor: pointer; }

  @media (max-width: 900px) {
    .garden-intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .garden-lede { max-width: 36rem; }
    .flower-story { grid-template-columns: 1fr; grid-template-rows: 35% 65%; width: min(34rem, 86%); }
    .story-copy { justify-content: flex-start; padding: 2.3rem; }
    .story-copy h2 { font-size: 3.3rem; }
    .group-legend { grid-template-columns: repeat(2, 1fr); }
    .index-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .garden-stage { height: 72svh; min-height: 35rem; }
    .garden-toolbar { top: .8rem; left: .8rem; right: .8rem; justify-content: space-between; }
    .garden-toolbar button { padding: .5rem .7rem; }
    .garden-time { top: 4.45rem; right: 1rem; }
    .garden-time time { font-size: 1.25rem; }
    .garden-instruction { bottom: 1rem; max-width: 90%; text-align: center; white-space: normal; }
    .flower-story { width: 100%; grid-template-rows: 30% 70%; }
    .story-copy { padding: 2rem 1.5rem 2.5rem; }
    .story-description { font-size: .84rem; }
    .group-legend { grid-template-columns: 1fr 1fr; padding-inline: 1rem; }
    .legend-item { padding: .55rem .3rem; }
    .index-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flower-story { transition: none; }
  }
</style>

---
import { EMOTIONAL_GROUPS } from "../../data/emotional-groups";

interface Flower {
  id: number;
  slug: string;
  name: string;
  botanical: string;
  emotionalGroup: string;
  desc: string;
  emotionalState: string;
  positiveState: string;
  affirmation: string;
  img: string;
}

interface Props {
  flower: Flower;
  previous: Flower;
  next: Flower;
}

const { flower, previous, next } = Astro.props;
const group = EMOTIONAL_GROUPS.find((item) => item.slug === flower.emotionalGroup);
const groupIndex = EMOTIONAL_GROUPS.findIndex((item) => item.slug === flower.emotionalGroup) + 1;

const GROUP_ACCENTS: Record<string, string> = {
  fear: "#a86450",
  uncertainty: "#a98435",
  "insufficient-interest": "#6e815a",
  loneliness: "#647f8c",
  oversensitivity: "#8b6679",
  "despondency-despair": "#706b87",
  "over-care-for-others": "#936a4e",
};
---

<article class="flower-profile" style={`--accent:${GROUP_ACCENTS[flower.emotionalGroup] ?? "#6e815a"}`}>
  <nav class="profile-breadcrumb" aria-label="Migas de pan">
    <a href="/flores-de-bach"><span aria-hidden="true">←</span> Volver al jardín</a>
    <div aria-hidden="true"></div>
    <p>Atlas emocional · Lámina {String(flower.id).padStart(2, "0")}</p>
  </nav>

  <header class="profile-hero">
    <figure class="profile-image">
      <img
        src={flower.img}
        alt={`Flor de Bach ${flower.name}`}
        transition:name={`flower-image-${flower.slug}`}
      />
      <figcaption>
        <span>Fotografía botánica</span>
        <i></i>
        <em>{flower.botanical}</em>
      </figcaption>
      <div class="specimen-mark" aria-hidden="true">
        <span>{String(flower.id).padStart(2, "0")}</span>
        <small>/ 38</small>
      </div>
    </figure>

    <div class="profile-introduction">
      <div class="group-register">
        <span>Grupo {String(groupIndex).padStart(2, "0")}</span>
        <i></i>
        <p>{group?.label}</p>
      </div>
      <h1 class:list={{ "long-name": flower.name.length > 15 }} transition:name={`flower-name-${flower.slug}`}>{flower.name}</h1>
      <p class="botanical-name">{flower.botanical}</p>
      <p class="profile-description">{flower.desc}</p>

      <div class="group-note">
        <span aria-hidden="true"></span>
        <div>
          <small>Territorio emocional</small>
          <p>{group?.description}</p>
        </div>
      </div>
    </div>
  </header>

  <section class="emotional-passage" aria-labelledby="passage-title">
    <div class="passage-heading">
      <p>Lectura emocional</p>
      <h2 id="passage-title">El movimiento interior</h2>
    </div>

    <div class="passage-grid">
      <article>
        <p class="passage-label"><span>01</span> Cuando se pierde el equilibrio</p>
        <p>{flower.emotionalState}</p>
      </article>

      <div class="passage-axis" aria-hidden="true">
        <span></span>
        <i>→</i>
        <span></span>
      </div>

      <article class="toward">
        <p class="passage-label"><span>02</span> La cualidad que puede emerger</p>
        <p>{flower.positiveState}</p>
      </article>
    </div>
  </section>

  <section class="affirmation" aria-labelledby="affirmation-title">
    <div class="affirmation-register">
      <span>Práctica de atención</span>
      <small>{String(flower.id).padStart(2, "0")} · {flower.name}</small>
    </div>
    <div>
      <h2 id="affirmation-title">Una frase para recordar</h2>
      <blockquote>“{flower.affirmation}”</blockquote>
    </div>
    <div class="affirmation-seal" aria-hidden="true">
      <span>EA</span>
      <small>38</small>
    </div>
  </section>

  <aside class="editorial-note">
    <span>Nota editorial</span>
    <p>
      Esta ficha presenta el uso tradicional de la esencia dentro del sistema
      desarrollado por Edward Bach. Es contenido divulgativo y no sustituye el
      consejo, diagnóstico ni tratamiento de profesionales sanitarios.
    </p>
  </aside>

  <nav class="flower-pagination" aria-label="Navegar entre flores">
    <a href={`/flores-de-bach/${previous.slug}`} class="previous">
      <img src={previous.img} alt="" loading="lazy" />
      <span class="pagination-direction">← Esencia anterior</span>
      <span class="pagination-name">{previous.name}</span>
      <small>{String(previous.id).padStart(2, "0")} · {previous.botanical}</small>
    </a>
    <a href="/flores-de-bach" class="atlas-link" aria-label="Volver al índice de las 38 flores">
      <span></span><span></span><span></span><span></span>
      <small>Índice</small>
    </a>
    <a href={`/flores-de-bach/${next.slug}`} class="next">
      <img src={next.img} alt="" loading="lazy" />
      <span class="pagination-direction">Esencia siguiente →</span>
      <span class="pagination-name">{next.name}</span>
      <small>{String(next.id).padStart(2, "0")} · {next.botanical}</small>
    </a>
  </nav>
</article>

<style>
  .flower-profile {
    --paper: #f1ecdd;
    --paper-deep: #e6dfcb;
    --ink: #183126;
    width: 100vw;
    margin: -3rem 0 0 calc(50% - 50vw);
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
  }

  .profile-breadcrumb {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    min-height: 5rem;
    padding: 0 clamp(1.5rem, 6vw, 6rem);
    border-bottom: 1px solid rgb(36 59 45 / 15%);
  }
  .profile-breadcrumb a { color: var(--ink); font-size: .67rem; font-weight: 700; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .profile-breadcrumb a span { margin-right: .5rem; color: var(--accent); }
  .profile-breadcrumb div { height: 1px; background: rgb(36 59 45 / 13%); }
  .profile-breadcrumb p { margin: 0; color: #718070; font-size: .62rem; letter-spacing: .16em; text-transform: uppercase; }

  .profile-hero { display: grid; grid-template-columns: minmax(26rem, 1.08fr) minmax(26rem, .92fr); min-height: calc(100svh - 10rem); }
  .profile-image { position: relative; min-height: 46rem; margin: 0; overflow: hidden; background: #243c2e; }
  .profile-image::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 52%, rgb(9 24 15 / 72%) 100%), linear-gradient(90deg, rgb(11 28 18 / 12%), transparent 30%); pointer-events: none; }
  .profile-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.82) contrast(1.04); transition: transform 1.2s cubic-bezier(.22, 1, .36, 1), filter .6s ease; }
  .profile-image:hover img { transform: scale(1.025); filter: saturate(.98) contrast(1.02); }
  .profile-image figcaption { position: absolute; z-index: 2; right: 2rem; bottom: 2rem; left: 2rem; display: flex; align-items: center; gap: .8rem; color: #eef0df; font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; }
  .profile-image figcaption i { flex: 1; height: 1px; background: rgb(255 255 255 / 35%); }
  .profile-image figcaption em { font-family: "Cormorant Garamond", serif; font-size: .8rem; letter-spacing: .05em; text-transform: none; }
  .specimen-mark { position: absolute; z-index: 2; top: 2rem; left: 2rem; display: flex; align-items: baseline; color: white; text-shadow: 0 2px 20px rgb(0 0 0 / 28%); }
  .specimen-mark span { font-family: "Cormorant Garamond", serif; font-size: clamp(4rem, 7vw, 7rem); font-weight: 400; line-height: .8; }
  .specimen-mark small { margin-left: .5rem; font-size: .62rem; letter-spacing: .15em; }

  .profile-introduction { position: relative; display: flex; flex-direction: column; justify-content: center; padding: clamp(4rem, 9vw, 9rem) clamp(2rem, 7vw, 7rem); background: var(--paper); isolation: isolate; }
  .profile-introduction::before { content: ""; position: absolute; inset: 0; z-index: -1; opacity: .16; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E"); }
  .group-register { display: flex; align-items: center; gap: .75rem; margin-bottom: 2.5rem; color: #687968; font-size: .6rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .group-register i { width: 2.8rem; height: 1px; background: var(--accent); }
  .group-register p { margin: 0; color: var(--accent); }
  .profile-introduction h1 { max-width: 9ch; margin: 0; font-family: "Cormorant Garamond", serif; font-size: clamp(5rem, 9vw, 9rem); font-weight: 500; line-height: .72; letter-spacing: -.06em; overflow-wrap: break-word; }
  .profile-introduction h1.long-name { max-width: 11ch; font-size: clamp(4.3rem, 7.2vw, 7.2rem); line-height: .78; }
  .botanical-name { margin: 1.5rem 0 3rem; color: #778476; font-family: "Cormorant Garamond", serif; font-size: 1.25rem; font-style: italic; }
  .profile-description { max-width: 35rem; margin: 0; color: #425648; font-size: clamp(.95rem, 1.25vw, 1.08rem); line-height: 1.85; }
  .group-note { display: grid; grid-template-columns: 2.8rem 1fr; gap: 1rem; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid rgb(35 57 43 / 17%); }
  .group-note > span { align-self: start; width: .75rem; height: .75rem; margin-top: .2rem; border: 1px solid var(--accent); border-radius: 50%; box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent); }
  .group-note small { color: #788477; font-size: .55rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .group-note p { max-width: 28rem; margin: .45rem 0 0; color: #536556; font-family: "Cormorant Garamond", serif; font-size: 1.15rem; line-height: 1.45; }

  .emotional-passage { padding: clamp(5rem, 9vw, 9rem) clamp(1.5rem, 7vw, 7rem); color: #f1eddd; background: #173126; }
  .passage-heading { display: grid; grid-template-columns: .55fr 1.45fr; align-items: end; gap: 3rem; max-width: 86rem; margin: 0 auto clamp(4rem, 7vw, 7rem); }
  .passage-heading > p { margin: 0; color: #8ca08e; font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .passage-heading h2 { max-width: 15ch; margin: 0; font-family: "Cormorant Garamond", serif; font-size: clamp(3.5rem, 6vw, 6.5rem); font-weight: 500; line-height: .86; letter-spacing: -.045em; }
  .passage-grid { display: grid; grid-template-columns: 1fr 8rem 1fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; max-width: 86rem; margin: 0 auto; }
  .passage-grid article { min-height: 18rem; padding: 2rem 0; border-block: 1px solid rgb(222 232 216 / 18%); }
  .passage-grid article > p:last-child { margin: 4rem 0 0; color: #b7c4b6; font-family: "Cormorant Garamond", serif; font-size: clamp(1.35rem, 2.1vw, 2rem); line-height: 1.35; }
  .passage-grid .toward > p:last-child { color: #e9e6d6; }
  .passage-label { display: flex; align-items: center; gap: .8rem; margin: 0; color: #899b8a; font-size: .58rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .passage-label span { color: var(--accent); font-family: "Cormorant Garamond", serif; font-size: 1rem; }
  .passage-axis { display: flex; align-items: center; gap: .8rem; color: var(--accent); }
  .passage-axis span { flex: 1; height: 1px; background: rgb(232 236 222 / 18%); }
  .passage-axis i { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border: 1px solid color-mix(in srgb, var(--accent) 65%, white); border-radius: 50%; font-style: normal; }

  .affirmation { position: relative; display: grid; grid-template-columns: .45fr 1.35fr .2fr; gap: 3rem; align-items: start; padding: clamp(6rem, 12vw, 12rem) clamp(1.5rem, 8vw, 8rem); background: var(--paper-deep); overflow: hidden; }
  .affirmation::before { content: "“"; position: absolute; top: -7rem; left: 40%; color: rgb(31 55 41 / 6%); font-family: "Cormorant Garamond", serif; font-size: 36rem; line-height: 1; pointer-events: none; }
  .affirmation-register { display: flex; flex-direction: column; gap: .45rem; padding-top: .7rem; border-top: 1px solid #aeb8a8; color: #677768; }
  .affirmation-register span { font-size: .58rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .affirmation-register small { font-family: "Cormorant Garamond", serif; font-size: .9rem; font-style: italic; }
  .affirmation h2 { margin: 0 0 2rem; color: #788578; font-size: .6rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .affirmation blockquote { position: relative; margin: 0; font-family: "Cormorant Garamond", serif; font-size: clamp(3rem, 6vw, 6rem); font-weight: 400; line-height: .94; letter-spacing: -.035em; }
  .affirmation-seal { display: grid; place-items: center; width: 5rem; height: 5rem; border: 1px solid var(--accent); border-radius: 50%; color: var(--accent); transform: rotate(8deg); }
  .affirmation-seal span { font-family: "Cormorant Garamond", serif; font-size: 1.5rem; line-height: 1; }
  .affirmation-seal small { font-size: .55rem; letter-spacing: .14em; }

  .editorial-note { display: grid; grid-template-columns: .45fr 1.55fr; gap: 3rem; padding: 2.5rem clamp(1.5rem, 8vw, 8rem); border-block: 1px solid rgb(33 55 42 / 14%); background: var(--paper); }
  .editorial-note span { color: #778376; font-size: .55rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .editorial-note p { max-width: 50rem; margin: 0; color: #657466; font-size: .72rem; line-height: 1.7; }

  .flower-pagination { display: grid; grid-template-columns: 1fr 7rem 1fr; min-height: 24rem; background: #12271e; }
  .flower-pagination > a:not(.atlas-link) { position: relative; display: flex; flex-direction: column; justify-content: end; min-width: 0; padding: 3rem clamp(1.5rem, 5vw, 5rem); overflow: hidden; color: white; text-decoration: none; isolation: isolate; }
  .flower-pagination > a:not(.atlas-link)::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(8 24 14 / 20%), rgb(8 24 14 / 88%)); transition: background .35s ease; }
  .flower-pagination > a:not(.atlas-link):hover::after { background: linear-gradient(180deg, rgb(8 24 14 / 6%), rgb(8 24 14 / 72%)); }
  .flower-pagination img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; filter: saturate(.65); transition: transform .8s cubic-bezier(.22, 1, .36, 1), filter .5s ease; }
  .flower-pagination a:hover img { transform: scale(1.04); filter: saturate(.95); }
  .flower-pagination .next { align-items: end; text-align: right; }
  .pagination-direction { margin-bottom: 1rem; color: #c2cebd; font-size: .58rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .pagination-name { font-family: "Cormorant Garamond", serif; font-size: clamp(2.4rem, 4vw, 4rem); line-height: .9; }
  .flower-pagination small { margin-top: .65rem; color: #9caf9f; font-size: .58rem; font-style: italic; }
  .atlas-link { display: flex; flex-wrap: wrap; place-content: center; gap: .35rem; padding: 2rem; border-inline: 1px solid rgb(235 240 225 / 12%); color: #d6ddcf; text-decoration: none; }
  .atlas-link span { width: .42rem; height: .42rem; border: 1px solid #839985; border-radius: 50%; }
  .atlas-link small { flex-basis: 100%; margin-top: .5rem; text-align: center; font-size: .52rem; font-style: normal; letter-spacing: .15em; text-transform: uppercase; }

  @media (max-width: 900px) {
    .profile-hero { grid-template-columns: 1fr; }
    .profile-image { min-height: 70svh; }
    .passage-heading { grid-template-columns: 1fr; }
    .passage-grid { grid-template-columns: 1fr; }
    .passage-axis { transform: rotate(90deg); justify-self: center; width: 7rem; }
    .affirmation { grid-template-columns: 1fr; }
    .affirmation-seal { position: absolute; right: 2rem; bottom: 2rem; }
    .editorial-note { grid-template-columns: 1fr; gap: 1rem; }
  }

  @media (max-width: 620px) {
    .profile-breadcrumb { grid-template-columns: 1fr auto; }
    .profile-breadcrumb div { display: none; }
    .profile-breadcrumb p { text-align: right; }
    .profile-image { min-height: 60svh; }
    .profile-introduction { padding-block: 5rem; }
    .profile-introduction h1 { font-size: clamp(4.5rem, 24vw, 7rem); }
    .passage-grid article > p:last-child { margin-top: 2.5rem; }
    .affirmation-seal { display: none; }
    .flower-pagination { grid-template-columns: 1fr 4rem 1fr; min-height: 19rem; }
    .flower-pagination > a:not(.atlas-link) { padding: 1.5rem 1rem; }
    .pagination-name { font-size: 1.8rem; }
    .flower-pagination small { display: none; }
    .atlas-link { padding: .5rem; }
  }
</style>

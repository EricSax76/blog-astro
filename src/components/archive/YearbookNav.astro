---
// Índice de años del anuario: histórico estático + el año vivo de Firestore.
// Incluye el año actual y el activo aunque aún no estén en la lista base.
import { ARCHIVE_YEARS } from "../../data/archive";

const staticYears: number[] = [...ARCHIVE_YEARS];
const { activeYear } = Astro.props;
const currentYear = new Date().getFullYear();

const years = Array.from(
  new Set([currentYear, activeYear, ...staticYears].filter((y) => typeof y === "number"))
).sort((a, b) => b - a);
---

<nav aria-label="Anuarios por año" class="border-y border-ink/10 py-4" data-reveal>
  <ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
    <li
      class="text-[0.65rem] font-semibold uppercase tracking-[0.3em] text-moss-text"
      aria-hidden="true"
    >
      Índice
    </li>
    {
      years.map((year) => (
        <li>
          <a
            href={`/archivo/${year}`}
            aria-current={activeYear === year ? "page" : undefined}
            class={`font-serif text-lg transition-colors ${
              activeYear === year
                ? "border-b-2 border-pollen pb-0.5 font-bold text-ink"
                : "font-medium text-moss-text hover:text-ink focus-visible:text-ink"
            }`}
          >
            {year}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

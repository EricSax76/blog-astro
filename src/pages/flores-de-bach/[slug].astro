---
import Layout from "../../layouts/Layout.astro";
import FlowerProfile from "../../components/flowers/FlowerProfile.astro";
import { flowers } from "../../data/flowers";

export const prerender = true;

export function getStaticPaths() {
  return flowers.map((flower, index) => ({
    params: { slug: flower.slug },
    props: {
      flower,
      previous: flowers[(index - 1 + flowers.length) % flowers.length],
      next: flowers[(index + 1) % flowers.length],
    },
  }));
}

const { flower, previous, next } = Astro.props;
---

<Layout
  title={`${flower.name} — Flores de Bach`}
  description={flower.desc}
  image={flower.img}
  type="article"
>
  <FlowerProfile {flower} {previous} {next} />
</Layout>

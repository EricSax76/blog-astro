---
import Layout from "../../../layouts/Layout.astro";
import YearbookShell from "../../../components/archive/YearbookShell.astro";
import YearbookEntry from "../../../components/archive/YearbookEntry.astro";

interface Props {
  year: number;
}

const { year } = Astro.props;
---

<Layout title={`Anuario ${year} | El Alma de las Flores`}>
  <YearbookShell year={year} subtitle="Un espacio para las nuevas entradas del año.">
    <div id="posts-grid" data-year={year} class="grid gap-10" aria-live="polite">
      <div
        id="posts-loading"
        class="rounded-2xl border border-moss/15 bg-paper-dim/60 p-8 text-center"
      >
        <p class="font-serif text-2xl font-bold text-ink">Abriendo el cuaderno</p>
        <p class="mt-2 text-sm leading-relaxed text-ink/70">
          Consultando las publicaciones del año…
        </p>
      </div>

      <div
        id="posts-error"
        class="hidden rounded-2xl border border-petal/40 bg-paper-dim/60 p-8 text-center"
      >
        <p class="font-serif text-2xl font-bold text-ink">
          No se pudieron cargar las entradas
        </p>
        <p class="mt-2 text-sm leading-relaxed text-ink/70">
          Revisa configuración, reglas de Firestore e índice requerido.
        </p>
      </div>

      <div
        id="posts-empty"
        class="hidden rounded-2xl border border-moss/15 bg-paper-dim/60 p-8 text-center"
      >
        <p class="font-serif text-2xl font-bold text-ink">Próximamente</p>
        <p class="mt-2 text-sm leading-relaxed text-ink/70">
          Aquí aparecerán los posts publicados en {year}. Este espacio está
          listo para recibir nuevos textos, reflexiones y fotografías: cuando
          publiques desde el panel, las entradas aparecerán automáticamente.
        </p>
      </div>
    </div>

    <!-- Plantilla del pliego: yearbook.ts la clona para cada post de Firestore,
         de modo que el markup del anuario dinámico y el estático es el mismo. -->
    <template id="yearbook-entry-template">
      <YearbookEntry template />
    </template>
  </YearbookShell>
</Layout>

<script src="../../../scripts/posts/archive/yearbook.ts"></script>
